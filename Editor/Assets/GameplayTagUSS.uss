/*
Gameplay Tag field (GameplayTagDrawer). Everything here is inside the field's input: a one-line box in the LMK theme,
only as wide as the tag's path (up to the input's width, then the path is cut with an ellipsis), and the arrow after
the box, outside it. The box and the arrow are clicked together.
*/
.gameplay-tag__content {
	flex-grow: 0;
	flex-shrink: 1;
	flex-direction: row;
	align-items: center;
	align-self: flex-start; /* The template container is a column: on the left, not stretched across it. */
	max-width: 100%;
	min-width: 0px;
}

.gameplay-tag__box {
	flex-grow: 0;
	flex-shrink: 1;
	flex-direction: row;
	align-items: center;
	height: 18px;
	min-width: 0px;
	padding: 0px 4px 0px 4px;
	overflow: hidden;

	background-color: var(--gameplay-tag-color-tag-background);
	border-width: 1px;
	border-color: var(--gameplay-tag-color-tag-border);
	border-radius: 3px;

	transition-property: background-color, border-color;
	transition-duration: 0.1s;
}

/* Hovering the arrow highlights the box too: they open the same picker. */
.gameplay-tag__content:hover > .gameplay-tag__box {
	background-color: var(--gameplay-tag-color-tag-background-hover);
	border-color: var(--gameplay-tag-color-tag-border-hover);
}

.gameplay-tag__switcher {
	flex-grow: 0;
	flex-shrink: 1;
	min-width: 0px;
}

.gameplay-tag__tag-label,
.gameplay-tag__placeholder-label {
	flex-grow: 0;
	flex-shrink: 1;
	padding: 0px;
	margin: 0px;
	overflow: hidden;

	text-overflow: ellipsis;
	-unity-text-align: middle-left;
}

/* None, or "- Mixed -" when the selected objects hold different tags. */
.gameplay-tag__placeholder-label {
	color: var(--lmk-color-text-muted);
}

.gameplay-tag__dropdown-arrow {
	flex-shrink: 0;
	width: 12px;
	height: 12px;
	margin: 0px 2px 0px 3px;

	background-image: url("Sprites/down-arrow_white_32.png");
	-unity-background-image-tint-color: var(--lmk-color-icon);
	-unity-background-scale-mode: scale-to-fit;
}


/*
Tag references that don't resolve: deleted, or from a registry that isn't loaded.
*/
.gameplay-tag--missing {
	color: var(--lmk-color-text-error);
	-unity-font-style: italic;
}

/*
Implicit tags: they exist only as parents of added tags.
*/
.gameplay-tag--implicit {
	-unity-font-style: italic;
}
