/*
Attribute Manager. Layout, toolbar, tree rows and inspector come from the Gameplay Tag Manager's stylesheets
(GeneralGameplayTagUSS, GameplayTagManagerWindowUSS, GameplayTagControlPanelUSS, GameplayTagElementUSS); these
are the attribute additions.
*/

/* Shown above the tree while the project has no main registry. */
.attribute-manager__create {
	flex-shrink: 0;
	align-items: center;
	padding: 16px 12px;

	border-bottom-width: 1px;
	border-color: var(--lmk-color-border);
}

.attribute-manager__create > Label {
	margin-bottom: 8px;
}



/*
Tree rows: an attribute's name, then a summary of its values at the end of the row.
*/
#leaf-tag-container.attribute-row {
	flex-direction: row;
	align-items: center;
}

.attribute-row__summary {
	flex-grow: 1;
	flex-shrink: 1;
	margin-left: 8px;
	padding: 0px 4px 0px 0px;
	overflow: hidden;

	color: var(--lmk-color-text-muted);
	font-size: 11px;
	-unity-font-style: normal;
	-unity-text-align: middle-right;
	text-overflow: ellipsis;
}



/*
Inspector
*/
.attribute-inspector__field {
	flex-grow: 1;
	margin: 0px;
}

.attribute-inspector__field .unity-base-field__input,
.attribute-inspector__field .unity-text-field__input {
	background-color: var(--lmk-color-field-background);
}

/* Attributes that use this one as a bound. */
.attribute-inspector__links {
	flex-direction: row;
	flex-wrap: wrap;
	flex-grow: 1;
	margin: 0px -2px;
}

.attribute-inspector__links > .tag-inspector__chip {
	margin: 0px 2px 2px 2px;
}

/* Min and Max: the bound's kind, then its value. */
.attribute-bound {
	flex-direction: row;
	flex-grow: 1;
	align-items: center;
}

.attribute-bound__kind {
	width: 92px;
	flex-shrink: 0;
	margin: 0px;
}

.attribute-bound__value {
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 40px;
	margin: 0px 0px 0px 4px;
}

.attribute-bound__value.tag-inspector__chip {
	height: 20px;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
