/*
Gameplay Tag Container field (GameplayTagContainerDrawer). Everything here is inside the field's input: a dropdown box
in the LMK theme, filling the input, as tall as its tags (at least one line), with the arrow at its end.
*/
.gameplay-tag__box {
	flex-grow: 1;
	flex-shrink: 1;
	flex-direction: row;
	align-items: flex-start;
	min-width: 0;
	min-height: 18px;
	padding: 0px 2px 0px 1px;
	overflow: hidden;

	background-color: var(--lmk-color-field-background);
	border-width: 1px;
	border-color: var(--lmk-color-field-border);
	border-radius: 3px;

	transition-property: background-color, border-color;
	transition-duration: 0.1s;
}

.gameplay-tag__box:hover {
	background-color: var(--lmk-color-field-background-hover);
	border-color: var(--lmk-color-field-border-hover);
}

.gameplay-tag__dropdown-arrow {
	flex-shrink: 0;
	align-self: center;
	width: 12px;
	height: 12px;
	margin: 0px 0px 0px 2px;

	background-image: url("Sprites/down-arrow_white_32.png");
	-unity-background-image-tint-color: var(--lmk-color-icon);
	-unity-background-scale-mode: scale-to-fit;
}

.gameplay-tag__switcher {
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
}

.gameplay-tag__tag-container-content {
	flex-grow: 1;
	flex-direction: column;
	padding: 2px 1px 1px 1px;

	overflow: hidden;
}

.gameplay-tag__tag-container-content .gameplay-tag__tag-value-container {
	flex-direction: row;
	margin: 0 0 1px 0;
}

.gameplay-tag__tag-container-content .gameplay-tag__tag-value {
	flex-grow: 0;
	flex-shrink: 1;
	height: 14px;
	padding: 0 4px 0 4px;
	margin: 0;
	overflow: hidden;

	background-color: var(--lmk-color-header-background-hover);
	border-radius: 0 3px 3px 0;

	text-overflow: ellipsis;
	-unity-text-align: middle-left;
}

.gameplay-tag__tag-container-content .gameplay-tag__tag-value-clear-button {
	flex-shrink: 0;
	width: 14px;
	height: 14px;
	padding: 0 0 1px 0;
	margin: 0;

	border-width: 0 1px 0 0;
	border-color: var(--lmk-color-content-border);
	border-radius: 3px 0 0 3px;
	background-color: #6e3d32;

	-unity-text-align: middle-center;

	transition-property: background-color;
	transition-duration: 0.1s;
}

.gameplay-tag__tag-container-content .gameplay-tag__tag-value-clear-button:hover,
.gameplay-tag__tag-container-content .gameplay-tag__tag-value-clear-button:active {
	background-color: #913421;
}

.gameplay-tag__placeholder-label {
	flex-grow: 1;
	flex-shrink: 1;
	height: 16px;
	padding: 0 2px 0 2px;
	margin: 0;
	overflow: hidden;

	color: var(--lmk-color-text-muted);
	text-overflow: ellipsis;
	-unity-text-align: middle-left;
}


/*
Tag references that don't resolve: deleted, or from a registry that isn't loaded.
*/
.gameplay-tag--missing {
	color: var(--lmk-color-text-error);
	-unity-font-style: italic;
}

/*
Implicit tags: they exist only as parents of added tags.
*/
.gameplay-tag--implicit {
	-unity-font-style: italic;
}
