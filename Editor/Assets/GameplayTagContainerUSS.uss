.gameplay-tag__container {
	flex-direction: row;
	margin: 1px 0px 1px 3px;
}

.gameplay-tag__content-container {
	flex-grow: 1;
	flex-direction: row;

	border-radius: 4px;

	transition: background-color;
	transition-duration: 0.1s;
}
.gameplay-tag__content-container:hover {
	background-color: var(--lmk-color-item-hover);
}

.gameplay-tag__tag-container {
	min-height: 20px;
	align-items: center;
	flex-grow: 1;
	flex-direction: row;
	justify-content: space-between;
	padding: 2px;

	background-color: var(--lmk-color-field-background);
	border-radius: 4px;
	border-width: 1px;
	border-color: var(--lmk-color-field-border);
}

.gameplay-tag__tag-container-content {
	flex-grow: 1;
	flex-direction: column;
	margin-bottom: -2px;

	overflow: hidden;
}

.gameplay-tag__tag-container-dropdown-icon {
	min-height: 12px;
	height: 12px;
	min-width: 12px;
	width: 12px;
	margin: 0px 2px 0px 2px;
	align-self: center;
	
	--unity-image: url("Sprites/down-arrow_white_32.png");
}

#property-label.gameplay-tag__label {
	width: 40%;
	min-width: 100px;
	padding: 2px 0px 0px 0px;

	-unity-text-align: upper-left;
}

.gameplay-tag__tag-container-content .gameplay-tag__tag-value {
	flex-grow: 0;
	height: 15px;
	padding: 0px 4px 1px 4px;
	margin: 0px 2px 2px 0px;
	overflow: hidden;

	background-color: var(--lmk-color-header-background-hover);
	border-radius: 0px 3px 3px 0px;

	text-overflow: ellipsis;
	-unity-text-align: middle-left;
}

.gameplay-tag__tag-container-content .gameplay-tag__tag-value-clear-button {
	width: 15px;
	height: 15px;
	padding: 0px 2px 2px 2px;
	margin: 0px;

	border-width: 0px 1px 0px 0px;
	border-color: var(--lmk-color-content-border);
	border-radius: 3px 0px 0px 3px;
	background-color: #6e3d32;

	-unity-text-align: middle-center;
	
	transition-property: background-color;
	transition-duration: 0.1s;
}

.gameplay-tag__tag-container-content .gameplay-tag__tag-value-clear-button:hover,
.gameplay-tag__tag-container-content .gameplay-tag__tag-value-clear-button:active {
	background-color: #913421;
}

#empty-tag-label.unity-label {
	align-self: stretch;
	flex-grow: 1;
	padding: 0px 2px 0px 2px;

	color: var(--lmk-color-text-placeholder);
}


/*
Tag references that don't resolve: deleted, or from a registry that isn't loaded.
*/
.gameplay-tag--missing {
	color: var(--lmk-color-text-error);
	-unity-font-style: italic;
}

/*
Implicit tags: they exist only as parents of added tags.
*/
.gameplay-tag--implicit {
	-unity-font-style: italic;
}
