* {
	--font-size: 12px;
	--text-field-h: 20px;

	--warning-color: #292410;
	--warning-color-light: #deb91f;

	--error-color: #2b0000;
	--error-color-light: #9e1515;
}

:root {
	align-content: stretch;
	flex-direction: column;
	flex-grow: 1;

	font-size: var(--font-size);
}



/*
Search bar controls
*/
#search-bar-controls {
	flex-direction: row;
	flex-shrink: 0;
	padding: 5px 5px 0px 5px;
}

#general-controls {
	min-height: 20px;
	min-width: 20px;
	height: 20px;
	width: 20px;
	flex-grow: 0;
	align-self: center;
	margin: 0px 0px 0px 4px;
	padding: 0px;

	background-color: rgba(0, 0, 0, 0);
	background-image: url("Sprites/gear_white_32.png");
	-unity-background-image-tint-color: var(--lmk-color-icon);
	background-size: 14px 14px;
	background-repeat: no-repeat;
	background-position-x: center;
	background-position-y: center;
	border-width: 0px;
	border-radius: 3px;

	transition: background-color;
	transition-duration: 0.1s;
}
#general-controls:hover {
	background-color: var(--lmk-color-item-hover);
}

#search-bar {
	flex-grow: 1;
}



.unity-text-field__input {
	background-color: var(--lmk-color-field-background);
}

.warning > .unity-text-field__input {
	border-color: var(--warning-color-light);
	background-color: var(--warning-color);
}



/*
Tag tree scroll-view
*/
#tag-tree-scroll-view {
	flex-grow: 1;
	align-self: stretch;
	padding: 2px;
	margin-top: 5px;
}

/* Without the header (the Gameplay Tag Manager has its own toolbar), the tree starts at the top. */
.gameplay-tag-control-panel--no-header #tag-tree-scroll-view {
	margin-top: 0px;
	border-top-width: 0px;
}



/*
Rename fields
*/
.tag-rename-field {
	position: absolute;
	margin: 0px;
	left: 2px;
	top: 1px;
	right: 2px;
	height: 20px;
}

.tag-rename-field #unity-text-input {
	padding: 0px;

	background-color: var(--lmk-color-field-background);
	border-color: #b3942e;
}

.tag-rename-field .unity-text-element {
	padding: 0px;
	margin: 0px 0px 0px 5px;
}

	

/*
Help box/message box
*/
#help-box-message {
	min-height: 48px;
	padding: 2px 10px 2px 10px;
	margin: 0px;

	background-color: var(--lmk-color-field-background);
	border-width: 1px 0 0 0 ;
	border-radius: 0;
	border-color: var(--lmk-color-border);
}

#help-box-message.warning {
	background-color: var(--warning-color);
}

#help-box-message.error {
	background-color: var(--error-color);
}

#empty-data-label {
	position: absolute;
	width: 100%;
	height: 100%;
	padding: 0px;

	color: var(--lmk-color-text-placeholder);
	-unity-text-align: middle-center;
}