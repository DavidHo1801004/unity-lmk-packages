<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xmlns:lmk="LMK.Editor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
>
<Style src="GameplayTagUSS.uss"/>
    <ui:VisualElement class="gameplay-tag__container">
        <ui:Label name="property-label" class="gameplay-tag__label"/>
        <ui:VisualElement name="main-container" class="gameplay-tag__content-container">
            <lmk:Switcher name="tag-label-switcher">
                <ui:Label name="empty-tag-label" text="None" class="gameplay-tag__empty-tag-label"/>
                <ui:Label name="tag-label" class="gameplay-tag__tag-label"/>
            </lmk:Switcher>
            <ui:Image name="dropdown-icon" class="gameplay-tag__tag-container-dropdown-icon"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>