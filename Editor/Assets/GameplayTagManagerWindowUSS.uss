* {
	--font-size: 12px;
	--text-field-h: 20px;

	--warning-color: #292410;
	--warning-color-light: #deb91f;

	--error-color: #2b0000;
	--error-color-light: #9e1515;
}

:root {
	align-content: stretch;
	flex-direction: column;
	flex-grow: 1;

	font-size: var(--font-size);
}



#switcher {
	align-items: center;
	justify-content: center;
}

#create-database-button {
	margin: 0px;
	padding: 10px 20px 10px 20px;
}

/* Clipped, so a toolbar wider than the panel never draws over the Inspector panel. */
#tree-panel {
	flex-direction: column;
	min-width: 160px;
	overflow: hidden;
	border-width: 1px;
	border-color: var(--lmk-color-border);
}



/*
Toolbar above the tag tree: Save, Discard, search, Add Tag, options.
*/
.gameplay-tag-toolbar {
	flex-direction: row;
	flex-shrink: 0;
	align-items: center;
	height: 22px;

	overflow: hidden;

	background-color: var(--lmk-color-header-background);
	border-bottom-width: 1px;
	border-color: var(--lmk-color-border);
}

/*
When the panel is narrow, the search field shrinks first, down to its minimum width. Past that, the buttons at
the end are cut off. The registry toolbar doesn't shrink by default, so its overflow would draw over the
Inspector panel.
*/
.gameplay-tag-toolbar > .registry-toolbar,
.gameplay-tag-toolbar .registry-toolbar__controls {
	flex-shrink: 1;
	min-width: 0px;
	overflow: hidden;
}

.gameplay-tag-toolbar .toolbar-button {
	flex-shrink: 0;
}

.gameplay-tag-toolbar > .toolbar-button {
	height: 21px;
	font-size: 12px;
	padding: 0px 8px 0px 8px;
	-unity-text-align: middle-center;
}

#search-field {
	flex-grow: 1;
	flex-shrink: 1;
	width: auto;
	min-width: 60px;
	margin: 0px 6px 0px 8px;
}

#options-button {
	width: 22px;
	padding: 3px;
}



/*
Add Tag popup
*/
#add-tag-popup {
	padding: 2px;
}

#add-tag-field {
	height: var(--text-field-h);
	margin: 0px;
}

#add-tag-field > .unity-label {
	min-width: 40px;
	padding: 0px 6px 0px 2px;

	-unity-text-align: middle-left;
}

#add-tag-field .unity-text-field__input {
	background-color: var(--lmk-color-field-background);
}

#add-tag-field.warning .unity-text-field__input {
	border-color: var(--warning-color-light);
	background-color: var(--warning-color);
}

#add-tag-error {
	margin: 4px 0px 0px 2px;

	color: var(--lmk-color-text-error);
	white-space: normal;
}



/*
Inspector panel
*/
.tag-inspector {
	flex-grow: 1;
	padding: 8px 8px 8px 8px;
	background-color: var(--lmk-color-popup-background);
}

.tag-inspector__placeholder {
	margin-top: 12px;

	color: var(--lmk-color-text-placeholder);
	white-space: normal;
	-unity-text-align: upper-center;
}

.tag-inspector__title {
	margin-bottom: 2px;
}

.tag-inspector__subheading {
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
}


.tag-inspector__muted {
	color: var(--lmk-color-text-muted);
}

/* Between the subheading and the fields. */
.tag-inspector__separator {
	margin: 2px 0px 2px 0px;
}

#details-separator.tag-inspector__separator > .named_separator__separator {
	background-color: var(--lmk-color-border);
}

.tag-inspector__rows {
	margin-top: 0px;
}

.tag-inspector__inline {
	flex-direction: row;
	flex-grow: 1;
	align-items: center;
}

.tag-inspector__inline > .unity-label {
	margin-right: 6px;
}

.tag-inspector__button {
	height: 20px;
	margin-left: 4px;
	padding: 0px 8px 0px 8px;
	border-width: 1px;
}

.tag-inspector__description {
	flex-grow: 1;
	margin: 0px;
	white-space: normal;
}

.tag-inspector__description .unity-text-field__input {
	min-height: 54px;

	background-color: var(--lmk-color-field-background);
	-unity-text-align: upper-left;
}

/*
Markers row: a chip per marker (colour and text set from code), with × to remove it, and + to add one.
*/
/* A box like a tag container field (GameplayTagContainerUSS): the chips, then + at the bottom. */
.tag-marker-field {
	flex-direction: row;
	flex-grow: 1;
	justify-content: space-between;
	min-height: 20px;
	padding: 2px;

	background-color: var(--lmk-color-field-background);
	border-radius: 4px;
	border-width: 1px;
	border-color: var(--lmk-color-field-border);
}

.tag-marker-field__chips {
	flex-direction: row;
	flex-wrap: wrap;
}

.tag-marker-field__empty {
	height: 15px;
	margin: 0px 0px 2px 0px;
	padding: 0px 2px 0px 2px;

	color: var(--lmk-color-text-placeholder);
	-unity-text-align: middle-left;
}

/* Drawn like a tag in a tag container field (GameplayTagContainerUSS): a remove button joined to the name. */
.tag-marker-field__chip {
	flex-direction: row;
	margin: 1px;
}

.tag-marker-field__chip-remove {
	width: 15px;
	height: 15px;
	padding: 0px 2px 2px 2px;
	margin: 0px;

	border-width: 0px 1px 0px 0px;
	border-color: var(--lmk-color-content-border);
	border-radius: 3px 0px 0px 3px;
	background-color: #6E3D32;

	-unity-text-align: middle-center;

	transition-property: background-color;
	transition-duration: 0.1s;
}

.tag-marker-field__chip-remove:hover,
.tag-marker-field__chip-remove:active {
	background-color: #913421;
}

/* Its colour, and a text colour that reads on it, are set from code. */
.tag-marker-field__chip-label {
	height: 15px;
	padding: 0px 4px 1px 4px;
	margin: 0px;
	overflow: hidden;

	border-radius: 0px 3px 3px 0px;

	text-overflow: ellipsis;
	-unity-text-align: middle-left;
}

/* At the bottom of the box, under the chips. */
.tag-marker-field__add {
	align-self: stretch;
	width: 20px;
	height: auto;
	margin: 0px;
	padding: 0px;
	flex-shrink: 0;
	flex-grow: 0;
}

/* New Marker popup */
#new-marker-popup {
	padding: 4px;
}

#new-marker-popup > .unity-base-field {
	margin: 0px 0px 4px 0px;
}

#new-marker-popup > .unity-base-field > .unity-label {
	min-width: 50px;
}

.tag-marker-field__swatches {
	flex-direction: row;
	flex-wrap: wrap;
	margin: 0px 0px 6px 50px;
}

.tag-marker-field__swatch {
	width: 18px;
	height: 18px;
	margin: 0px 4px 0px 0px;
	border-width: 2px;
	border-radius: 9px;
	border-color: rgba(0, 0, 0, 0);
}

.tag-marker-field__swatch:hover {
	border-color: var(--lmk-color-field-border-hover);
}

.tag-marker-field__swatch--picked,
.tag-marker-field__swatch--picked:hover {
	border-color: var(--lmk-color-link);
}

#new-marker-error {
	margin: 0px 0px 4px 2px;
	color: var(--lmk-color-text-error);
	white-space: normal;
}

#new-marker-add {
	align-self: flex-end;
	margin: 0px;
}

/*
Registry and parent links: boxed like inline code, rather than underlined text.
*/
.tag-inspector__chip.lmk-link-label,
.tag-inspector__chip#make-explicit-button {
	margin: 0 2px;
	padding: 1px 5px 1px 5px;
	border-width: 1px;
	border-radius: 3px;
	border-color: var(--lmk-color-field-border);

	background-color: var(--lmk-color-field-background);
	color: rgb(166, 166, 166);
	-unity-text-align: middle-left;
	white-space: normal;

	transition: background-color, border-color;
	transition-duration: 0.1s;
}

.tag-inspector__chip.lmk-link-label:hover:enabled,
.tag-inspector__chip#make-explicit-button:hover:enabled {
	padding-bottom: 1px;
	border-bottom-width: 1px;
	border-color: var(--lmk-color-field-border-hover);

	background-color: var(--lmk-color-field-background-hover);
}

.tag-inspector__chip.lmk-link-label:focus:enabled,
.tag-inspector__chip#make-explicit-button:focus:enabled {
	border-color: var(--lmk-color-link);
}

.tag-inspector__chip.lmk-link-label:disabled {
	color: var(--lmk-color-text-muted);
}
