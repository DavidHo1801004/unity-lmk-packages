<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xmlns:lmk="LMK.Editor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
>
<Style src="GameplayTagContainerUSS.uss"/>
    <ui:VisualElement name="main-container" class="gameplay-tag__box">
        <lmk:Switcher name="tag-container-switcher" class="gameplay-tag__switcher">
            <ui:Label name="empty-tag-label" text="Empty" class="gameplay-tag__placeholder-label"/>
            <ui:VisualElement name="tag-container-content" class="gameplay-tag__tag-container-content"/>
        </lmk:Switcher>
        <ui:VisualElement name="dropdown-arrow" class="gameplay-tag__dropdown-arrow" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>
