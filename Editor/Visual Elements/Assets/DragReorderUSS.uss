.drag-reorder__item--dragging {
	opacity: 0.5;
}

.drag-reorder__indicator {
	position: absolute;
	background-color: var(--lmk-color-drop-indicator);
}

.drag-reorder__indicator--horizontal {
	top: 0px;
	bottom: 0px;
	width: 2px;
	margin-left: -1px;
}

.drag-reorder__indicator--vertical {
	left: 0px;
	right: 0px;
	height: 2px;
	margin-top: -1px;
}
